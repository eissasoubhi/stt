{
  "manifest_version": 3,
  "name": "Arabic Voice Dictation",
  "version": "0.7.0",
  "description": "Dictate and translate into selected text fields only on sites you explicitly allow.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:3737/*",
    "http://localhost:3737/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Voice STT — sites autorisés",
    "default_popup": "popup.html"
  }
}
