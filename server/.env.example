HOST=127.0.0.1
PORT=3737

# Hard local guardrails. These are intentionally conservative.
MAX_RECORDING_SECONDS=60
MAX_AUDIO_BYTES=8388608
REQUESTS_PER_MINUTE_LIMIT=8
DAILY_AUDIO_MINUTES_LIMIT=30
MONTHLY_AUDIO_MINUTES_LIMIT=300

DEEPGRAM_ENABLED=true
DEEPGRAM_API_KEY=
DEEPGRAM_MONTHLY_AUDIO_MINUTES_LIMIT=300

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_MODE=SMART
GEMINI_MONTHLY_AUDIO_MINUTES_LIMIT=120

# Optional second step: translate/adapt the transcript into another language/dialect.
# groq = cloud free tier, gemini = cloud API, nllb = free/local.
TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=groq
DAILY_TRANSLATION_REQUEST_LIMIT=50
MONTHLY_TRANSLATION_REQUEST_LIMIT=500

# Groq Cloud translation (default).
GROQ_API_KEY=
GROQ_TRANSLATION_MODEL=qwen/qwen3.8-27b

# Free/local fallback. The model is downloaded on first use and cached locally.
NLLB_ENABLED=true
NLLB_MODEL=Xenova/nllb-200-distilled-600M
NLLB_DTYPE=q8

# Used only when Translation provider = Gemini.
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Disabled by default because this uses Google Cloud billing, not Gemini prepaid credit.
CHIRP_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=eu
# Example:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
CHIRP_MONTHLY_AUDIO_MINUTES_LIMIT=15
